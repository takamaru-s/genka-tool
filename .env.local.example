# Supabase接続 (Settings > Database > Connection string)
# PoolerのTransaction modeを使う (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Direct接続 (port 5432) - マイグレーション用
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# NextAuth (openssl rand -base64 32 で生成)
NEXTAUTH_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# VercelデプロイURL (例: https://genka-tool.vercel.app)
NEXTAUTH_URL="https://your-app.vercel.app"

# Anthropic APIキー (設定ページから登録も可、環境変数でも可)
ANTHROPIC_API_KEY="sk-ant-..."
